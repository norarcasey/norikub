{
  "permissions": {
    "allow": [
      "Bash(pnpm gate)",
      "Bash(pnpm verify)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(gh run watch:*)",
      "Bash(pnpm app:check)",
      "Bash(pnpm db:env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/scripts/session-start.ts\"",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/scripts/session-start.ts\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
